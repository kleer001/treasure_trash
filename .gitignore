node_modules/
*.log

# generated by tools/build-artifact.mjs — a publish output, not source
artifact.html

# the itch.io upload built by ./package.sh
dist/

# Scratch output of tools/act2.mjs — the table rows to paste into levels.md. Keeping a copy
# would be a second, unverified table: verify.mjs checks levels.md, not this.
levels/act*.md

# Browser-tool captures
.playwright-mcp/

# Build output of the sanctioned Rust port. Cargo.lock is committed — it is a binary.
engine/target/

# Written by tools/matrix.mjs --pack, so a case can be poked by hand in the real game. Its pars
# are computed from the rules that were in force when it ran, so a tracked copy goes stale on
# the next rules change and reads as a claim about rules nobody checked. Regenerate it.
levels/matrix.tt

# Written by tools/sweep.mjs --write for the page to fetch. Planned against the rules that were
# in force when it ran, so a tracked copy goes stale on the next rules change and would send a
# driver down keys that no longer cause what they claim. Regenerate it.
levels/sweep-*.json
